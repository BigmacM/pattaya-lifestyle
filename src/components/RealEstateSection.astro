---
import businessData from '../../content/business.json';

const { realEstate } = businessData.services;
const { title, description, package: marketingPackage } = realEstate;
---

<section class="py-16 md:py-20 lg:py-24 bg-sand-100">
  <div class="container-custom">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Left Column - Image -->
      <div class="order-2 lg:order-1">
        <div class="relative">
          <!-- Main Image -->
          <div class="rounded-2xl overflow-hidden shadow-soft-lg">
            <img
              src="/images/house-promo-interior.webp"
              alt="Professional property photography for real estate marketing"
              class="w-full h-64 lg:h-80 object-cover"
            />
          </div>

          <!-- Floating Price Badge -->
          <div class="absolute bottom-4 right-4 bg-white rounded-xl shadow-soft-lg p-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-secondary-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Starting from</p>
                <p class="font-semibold text-gray-900 text-sm">{marketingPackage.priceRange} {marketingPackage.currency}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Content -->
      <div class="order-1 lg:order-2">
        <span class="badge badge-green mb-4">Real Estate</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {title}
        </h2>
        <p class="text-gray-600 mb-6">
          {description}
        </p>

        <!-- Package Card -->
        <div class="bg-white rounded-2xl shadow-soft p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-display text-lg font-semibold text-gray-900">
              {marketingPackage.name}
            </h3>
            <span class="text-xs text-gray-500">{marketingPackage.priceNote}</span>
          </div>

          <div class="grid sm:grid-cols-2 gap-3">
            {marketingPackage.features.map((feature) => (
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-medium text-gray-900 text-sm">{feature.name}</h4>
                </div>
              </div>
            ))}
          </div>

          <!-- Price & CTA -->
          <div class="mt-5 pt-4 border-t border-gray-100">
            <a href="/contact" class="btn btn-primary w-full">
              Get a Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
