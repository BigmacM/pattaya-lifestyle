---
import businessData from '../../content/business.json';

const { realEstate } = businessData.services;
const { title, description, package: marketingPackage } = realEstate;
---

<section class="section bg-sand-100">
  <div class="container-custom">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Column - Image -->
      <div class="reveal order-2 lg:order-1">
        <div class="relative">
          <!-- Main Image -->
          <div class="rounded-3xl overflow-hidden shadow-soft-xl">
            <div class="aspect-[4/3] bg-gradient-to-br from-primary-200 to-primary-300 flex items-center justify-center">
              <div class="text-center p-8">
                <svg class="w-24 h-24 text-primary-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                <p class="text-primary-700 font-medium">Property Marketing</p>
              </div>
            </div>
          </div>

          <!-- Floating Badge -->
          <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-soft-lg p-6 max-w-xs">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-secondary-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Starting from</p>
                <p class="font-semibold text-gray-900">{marketingPackage.priceRange} {marketingPackage.currency}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Content -->
      <div class="reveal animation-delay-200 order-1 lg:order-2">
        <span class="badge badge-green mb-4">Real Estate</span>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          {title}
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          {description}
        </p>

        <!-- Package Card -->
        <div class="card bg-white mb-8">
          <div class="flex items-center justify-between mb-6">
            <h3 class="font-display text-xl font-semibold text-gray-900">
              {marketingPackage.name}
            </h3>
            <span class="text-sm text-gray-500">{marketingPackage.priceNote}</span>
          </div>

          <div class="space-y-4">
            {marketingPackage.features.map((feature) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                  {feature.icon === 'camera' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  )}
                  {feature.icon === 'video' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  )}
                  {feature.icon === 'drone' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  )}
                  {feature.icon === 'social' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                    </svg>
                  )}
                  {feature.icon === 'listing' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  )}
                </div>
                <div>
                  <h4 class="font-medium text-gray-900">{feature.name}</h4>
                  <p class="text-sm text-gray-600">{feature.description}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Price -->
          <div class="mt-6 pt-6 border-t border-gray-100 flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Package Price</p>
              <p class="price text-2xl text-primary-700">{marketingPackage.priceRange} <span class="price-currency">{marketingPackage.currency}</span></p>
            </div>
            <a href="/contact" class="btn btn-primary">
              Get Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
