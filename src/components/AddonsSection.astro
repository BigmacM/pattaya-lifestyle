---
import businessData from '../../content/business.json';

const { premiumAddons } = businessData.services;

const imageMap: Record<string, string> = {
  cleaning: '/images/cleaning-service.webp',
  linen: '/images/linen-laundry-card.webp',
  pool: '/images/pool-garden-card.webp'
};

const altMap: Record<string, string> = {
  cleaning: 'Professional cleaning service',
  linen: 'Fresh linen and laundry service',
  pool: 'Pool and garden maintenance'
};
---

<section class="py-16 md:py-20 lg:py-24 bg-white">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 fade-up">
      <span class="badge badge-gold mb-4">Add-ons</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Premium Home Services
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Enhance your property management with our premium add-on services
      </p>
    </div>

    <!-- 3 Column Add-on Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {premiumAddons.map((addon, index) => (
        <div class="bg-white rounded-2xl shadow-soft hover:shadow-soft-lg transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col h-full card-lift fade-up group" style={`animation-delay: ${index * 100}ms`}>
          <!-- Image -->
          <div class="relative h-40 overflow-hidden">
            <img
              src={imageMap[addon.icon]}
              alt={altMap[addon.icon]}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
          </div>

          <!-- Content -->
          <div class="p-5 flex flex-col flex-grow">
            <!-- Title & Description -->
            <h3 class="font-display text-lg font-semibold text-gray-900 mb-2">
              {addon.title}
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              {addon.description}
            </p>

            <!-- Price Options -->
            <div class="space-y-3 pt-4 border-t border-gray-100">
              {addon.options.map((option) => (
                <div class="flex justify-between items-center">
                  <div>
                    <p class="font-medium text-gray-900 text-sm">{option.name}</p>
                    <p class="text-xs text-gray-500">{option.note}</p>
                  </div>
                  <p class="font-semibold text-primary-700 text-sm whitespace-nowrap">
                    {option.priceRange} <span class="text-xs font-normal text-gray-500">{option.currency}</span>
                  </p>
                </div>
              ))}
            </div>

            <!-- CTA Button -->
            <a href="/contact" class="btn btn-outline btn-sm w-full mt-4">
              Get Quote
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Section CTA -->
    <div class="text-center mt-10 fade-up" style="animation-delay: 300ms;">
      <a href="/contact" class="btn btn-primary">
        Request All Add-on Services
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
