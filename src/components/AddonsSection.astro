---
import businessData from '../../content/business.json';

const { premiumAddons } = businessData.services;
---

<section class="section bg-white">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="badge badge-gold mb-4">Add-ons</span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Premium Home Services
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Enhance your property management with our premium add-on services
      </p>
    </div>

    <!-- 3 Column Add-on Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {premiumAddons.map((addon, index) => (
        <div
          class="card card-hover reveal overflow-hidden p-0"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Image -->
          <div class="relative h-48 overflow-hidden">
            {addon.icon === 'cleaning' && (
              <img
                src="/images/cleaning-service.webp"
                alt="Professional cleaning service"
                class="w-full h-full object-cover"
              />
            )}
            {addon.icon === 'linen' && (
              <img
                src="/images/linen-laundry-card.webp"
                alt="Fresh linen and laundry service"
                class="w-full h-full object-cover"
              />
            )}
            {addon.icon === 'pool' && (
              <img
                src="/images/pool-garden-card.webp"
                alt="Pool and garden maintenance"
                class="w-full h-full object-cover"
              />
            )}
          </div>

          <div class="p-6">
          <!-- Icon -->
          <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-4 -mt-10 relative z-10 shadow-soft">
            {addon.icon === 'cleaning' && (
              <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
            )}
            {addon.icon === 'linen' && (
              <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
              </svg>
            )}
            {addon.icon === 'pool' && (
              <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21c.6 0 1.2-.4 1.5-1 .5-1.1 1.3-1.5 2.5-1.5s2 .4 2.5 1.5c.3.6.9 1 1.5 1s1.2-.4 1.5-1c.5-1.1 1.3-1.5 2.5-1.5s2 .4 2.5 1.5c.3.6.9 1 1.5 1"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17c.6 0 1.2-.4 1.5-1 .5-1.1 1.3-1.5 2.5-1.5s2 .4 2.5 1.5c.3.6.9 1 1.5 1s1.2-.4 1.5-1c.5-1.1 1.3-1.5 2.5-1.5s2 .4 2.5 1.5c.3.6.9 1 1.5 1"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v8M9 6l3-3 3 3"/>
              </svg>
            )}
          </div>

          <!-- Title & Description -->
          <h3 class="font-display text-xl font-semibold text-gray-900 mb-2">
            {addon.title}
          </h3>
          <p class="text-gray-600 mb-6">
            {addon.description}
          </p>

          <!-- Price Options -->
          <div class="space-y-3 pt-4 border-t border-gray-100">
            {addon.options.map((option) => (
              <div class="flex justify-between items-center">
                <div>
                  <p class="font-medium text-gray-900">{option.name}</p>
                  <p class="text-sm text-gray-500">{option.note}</p>
                </div>
                <div class="text-right">
                  <p class="font-semibold text-primary-700">
                    {option.priceRange} <span class="text-sm font-normal text-gray-500">{option.currency}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- CTA -->
          <div class="mt-6">
            <a href="/contact" class="btn btn-outline w-full">
              Learn More
            </a>
          </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
