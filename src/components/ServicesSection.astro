---
import businessData from '../../content/business.json';

const { houseManagement } = businessData.services;
const { title, description, features, plans, offer } = houseManagement;
---

<section id="services" class="py-16 md:py-20 lg:py-24 bg-sand-50">
  <div class="container-custom">
    <!-- Section Header with Image -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center mb-12">
      <div class="order-2 lg:order-1 fade-up">
        <span class="badge badge-green mb-4">Our Services</span>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          {title}
        </h2>
        <p class="text-lg text-gray-600">
          {description}
        </p>
      </div>
      <div class="order-1 lg:order-2 fade-up" style="animation-delay: 150ms;">
        <div class="rounded-2xl overflow-hidden shadow-soft-lg group">
          <img
            src="/images/house-managment.webp"
            alt="Professional house management services in Pattaya"
            class="w-full h-56 lg:h-72 object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      </div>
    </div>

    <!-- Two Column Layout -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
      <!-- Left Column - Features List -->
      <div class="flex flex-col">
        <h3 class="font-display text-xl font-semibold text-gray-900 mb-6">
          Services Included
        </h3>
        <div class="grid sm:grid-cols-2 gap-4 flex-1 auto-rows-fr">
          {features.map((feature, index) => (
            <div class="flex gap-3 p-3 rounded-xl bg-white shadow-soft hover:shadow-soft-lg transition-all duration-300 card-lift fade-up" style={`animation-delay: ${200 + index * 50}ms`}>
              <div class="w-10 h-10 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center flex-shrink-0">
                {feature.icon === 'inspection' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                  </svg>
                )}
                {feature.icon === 'key' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                )}
                {feature.icon === 'ac' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
                {feature.icon === 'mail' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
                {feature.icon === 'emergency' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                )}
                {feature.icon === 'repair' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                )}
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">{feature.name}</h4>
                <p class="text-sm text-gray-600">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column - Pricing Cards -->
      <div>
        <!-- Offer Badge -->
        {offer && (
          <div class="bg-secondary-50 border border-secondary-200 rounded-xl p-4 mb-6 flex items-center gap-3">
            <span class="badge badge-gold">{offer.badge}</span>
            <div>
              <p class="font-semibold text-gray-900 text-sm">{offer.title}</p>
              <p class="text-xs text-gray-600">{offer.description}</p>
            </div>
          </div>
        )}

        <!-- Pricing Cards -->
        <div class="space-y-4">
          {plans.map((plan, index) => (
            <div class:list={['card p-5 card-lift fade-up', { 'card-featured ring-2 ring-secondary-400': plan.isFeatured, 'hover:shadow-soft-lg': !plan.isFeatured }]} style={`animation-delay: ${400 + index * 100}ms`}>
              <div class="flex items-start justify-between mb-3">
                <div>
                  <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-bold text-primary-700">{plan.price}</span>
                    <span class="text-sm text-gray-500">{plan.currency} / {plan.period}</span>
                  </div>
                  <h4 class="font-display text-lg font-semibold text-gray-900">{plan.name}</h4>
                </div>
                {plan.isFeatured && (
                  <span class="badge badge-gold text-xs">Popular</span>
                )}
              </div>
              <ul class="space-y-2 mb-4">
                {plan.features.slice(0, 4).map((feature) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-sm text-gray-600">{feature}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/contact"
                class:list={['btn btn-sm w-full', plan.isFeatured ? 'btn-primary' : 'btn-outline']}
              >
                Get Started
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
