---
import businessData from '../../content/business.json';
import TrustBadges from './TrustBadges.astro';

const { headline, subheadline, ctaText, ctaLink, trustLine } = businessData.hero;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-900/80 via-primary-800/70 to-primary-900/90 z-10"></div>
    <img src="/images/Hero-villa-lifestyle.webp" alt="Luxury pool villa in Pattaya - Property management services" class="absolute inset-0 w-full h-full object-cover" />

    <!-- Decorative Elements with Parallax -->
    <div class="absolute top-20 left-10 w-64 h-64 bg-secondary-400/10 rounded-full blur-3xl parallax-slow"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl parallax-slow" style="animation-delay: -3s;"></div>
  </div>

  <!-- Content -->
  <div class="relative z-20 container-custom text-center px-4 py-32">
    <div class="max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-8 animate-fade-in">
        <span class="w-2 h-2 bg-secondary-400 rounded-full animate-pulse"></span>
        <span class="text-white/90 text-sm font-medium">Pattaya Property Management for Absentee Owners</span>
      </div>

      <!-- Headline (H1 with primary keyword) -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 animate-slide-up">
        {headline}
      </h1>

      <!-- Subheadline with keywords -->
      <p class="text-xl md:text-2xl text-white/80 mb-6 max-w-2xl mx-auto animate-slide-up animation-delay-200">
        {subheadline}
      </p>

      <!-- Trust Line -->
      <p class="text-sm md:text-base text-secondary-400 font-medium mb-10 animate-slide-up animation-delay-200">
        {trustLine}
      </p>

      <!-- CTA Buttons - 48x48px touch targets -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 animate-slide-up animation-delay-400">
        <a href={ctaLink} class="btn btn-secondary text-lg px-8 py-4 min-h-[48px] hover-glow">
          {ctaText}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="tel:+66812345678" class="btn btn-ghost text-lg px-8 py-4 min-h-[48px]">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call Now
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="animate-slide-up animation-delay-400">
        <TrustBadges />
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0 z-20">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-auto">
      <path d="M0 120L48 110C96 100 192 80 288 70C384 60 480 60 576 65C672 70 768 80 864 85C960 90 1056 90 1152 85C1248 80 1344 70 1392 65L1440 60V120H0Z" fill="#fdfdf9"/>
    </svg>
  </div>
</section>
