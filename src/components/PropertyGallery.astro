---
interface Props {
  featuredImage: string;
  images: string[];
  title: string;
}

const { featuredImage, images, title } = Astro.props;

// Combine featured image with other images
const allImages = [featuredImage, ...images.filter(img => img !== featuredImage)];
---

<div class="property-gallery">
  <!-- Main Image -->
  <div class="relative rounded-2xl overflow-hidden mb-4 cursor-pointer group" id="main-image-container">
    <img
      src={featuredImage}
      alt={title}
      class="w-full h-[400px] md:h-[500px] object-cover transition-transform duration-500 group-hover:scale-105"
      id="main-gallery-image"
      onerror="this.src='/images/house-promo-interior.webp'"
    />

    <!-- Click to zoom overlay (center) -->
    <div id="main-image-zoom" class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center pointer-events-none">
      <div class="opacity-0 group-hover:opacity-100 transition-opacity">
        <div class="bg-white/90 backdrop-blur-sm rounded-full p-4">
          <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button id="main-prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-2 rounded-full shadow-lg transition-all opacity-0 group-hover:opacity-100 z-10">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="main-next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-2 rounded-full shadow-lg transition-all opacity-0 group-hover:opacity-100 z-10">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Image Counter -->
    <div class="absolute bottom-4 right-4 bg-black/70 text-white px-3 py-1.5 rounded-full text-sm font-medium">
      <span id="current-image-index">1</span> / {allImages.length}
    </div>
  </div>

  <!-- Thumbnail Grid -->
  {allImages.length > 1 && (
    <div class="grid grid-cols-4 md:grid-cols-6 gap-2">
      {allImages.slice(0, 6).map((image, index) => (
        <button
          class:list={[
            'thumbnail-btn relative rounded-lg overflow-hidden aspect-square cursor-pointer transition-all duration-200',
            index === 0 ? 'ring-2 ring-primary-500' : 'hover:ring-2 hover:ring-primary-300'
          ]}
          data-index={index}
          data-image={image}
          data-more={index === 5 && allImages.length > 6 ? 'true' : undefined}
        >
          <img
            src={image}
            alt={`${title} - Image ${index + 1}`}
            class="w-full h-full object-cover"
            onerror="this.src='/images/house-promo-interior.webp'"
          />
          {index === 5 && allImages.length > 6 && (
            <div class="more-images-overlay absolute inset-0 bg-black/60 flex items-center justify-center hover:bg-black/70 transition-colors">
              <span class="text-white font-semibold text-lg">+{allImages.length - 6}</span>
            </div>
          )}
        </button>
      ))}
    </div>
  )}

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center">
    <button id="close-lightbox" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10 p-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <button id="prev-image" class="absolute left-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 p-2 z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <button id="next-image" class="absolute right-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 p-2 z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <img id="lightbox-image" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />

    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white text-sm">
      <span id="lightbox-counter"></span>
    </div>
  </div>
</div>

<script define:vars={{ allImages, title }}>
  let currentIndex = 0;

  const mainImage = document.getElementById('main-gallery-image');
  const mainContainer = document.getElementById('main-image-container');
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const currentIndexSpan = document.getElementById('current-image-index');
  const thumbnailBtns = document.querySelectorAll('.thumbnail-btn');

  function updateMainImage(index) {
    currentIndex = index;
    if (mainImage) mainImage.src = allImages[index];
    if (currentIndexSpan) currentIndexSpan.textContent = (index + 1).toString();

    // Update thumbnail active state
    thumbnailBtns.forEach((btn, i) => {
      if (i === index) {
        btn.classList.add('ring-2', 'ring-primary-500');
        btn.classList.remove('hover:ring-2', 'hover:ring-primary-300');
      } else {
        btn.classList.remove('ring-2', 'ring-primary-500');
        btn.classList.add('hover:ring-2', 'hover:ring-primary-300');
      }
    });
  }

  function openLightbox(index) {
    currentIndex = index;
    if (lightbox) lightbox.classList.remove('hidden');
    if (lightbox) lightbox.classList.add('flex');
    if (lightboxImage) lightboxImage.src = allImages[index];
    if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${allImages.length}`;
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (lightbox) lightbox.classList.add('hidden');
    if (lightbox) lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % allImages.length;
    if (lightboxImage) lightboxImage.src = allImages[currentIndex];
    if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${allImages.length}`;
    updateMainImage(currentIndex);
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
    if (lightboxImage) lightboxImage.src = allImages[currentIndex];
    if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${allImages.length}`;
    updateMainImage(currentIndex);
  }

  // Event listeners

  // Main image click opens lightbox
  mainContainer?.addEventListener('click', (e) => {
    // Don't open lightbox if clicking on navigation arrows
    const target = e.target;
    if (target && target.closest && (target.closest('#main-prev') || target.closest('#main-next'))) {
      return;
    }
    openLightbox(currentIndex);
  });

  // Main slider navigation arrows
  document.getElementById('main-prev')?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
    updateMainImage(currentIndex);
  });

  document.getElementById('main-next')?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentIndex = (currentIndex + 1) % allImages.length;
    updateMainImage(currentIndex);
  });

  // Thumbnail clicks
  thumbnailBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.dataset.index || '0');
      const isMoreButton = btn.dataset.more === 'true';

      if (isMoreButton) {
        // Open lightbox when clicking on "+N more" thumbnail
        openLightbox(index);
      } else {
        updateMainImage(index);
      }
    });
  });

  document.getElementById('close-lightbox')?.addEventListener('click', closeLightbox);
  document.getElementById('next-image')?.addEventListener('click', nextImage);
  document.getElementById('prev-image')?.addEventListener('click', prevImage);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    }
  });
</script>
