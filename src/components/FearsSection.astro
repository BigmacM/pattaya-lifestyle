---
import businessData from '../../content/business.json';

const { fears } = businessData;
---

<section class="py-16 md:py-20 lg:py-24 bg-sand-100">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 fade-up">
      <span class="badge badge-gold mb-4">Asset Protection</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {fears.title}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {fears.description}
      </p>
    </div>

    <!-- Fears Grid -->
    <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto items-stretch">
      {fears.items.map((item, index) => (
        <div class="bg-white rounded-2xl p-6 shadow-soft hover:shadow-soft-lg transition-all duration-300 card-lift fade-up group h-full" style={`animation-delay: ${index * 100}ms`}>
          <div class="flex gap-4">
            <!-- Icon -->
            <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0 group-hover:bg-primary-100 group-hover:text-primary-600 transition-colors">
              {item.icon === 'mold' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              )}
              {item.icon === 'termite' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
              )}
              {item.icon === 'squatter' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              )}
              {item.icon === 'storm' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              )}
            </div>

            <!-- Content -->
            <div class="flex-1">
              <h3 class="font-display text-lg font-semibold text-gray-900 mb-2">
                {item.title}
              </h3>
              <p class="text-gray-600 text-sm mb-3">
                {item.description}
              </p>
              <div class="flex items-start gap-2 bg-primary-50 rounded-lg p-3">
                <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <p class="text-sm text-primary-700 font-medium">{item.solution}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 fade-up" style="animation-delay: 400ms;">
      <a href="/contact" class="btn btn-primary">
        Get a Free Property Assessment
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
