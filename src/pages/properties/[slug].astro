---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyGallery from '../../components/PropertyGallery.astro';
import propertiesData from '../../../content/properties.json';
import businessData from '../../../content/business.json';

export function getStaticPaths() {
  return propertiesData.properties.map((property) => ({
    params: { slug: property.slug },
    props: { property }
  }));
}

const { property } = Astro.props;
const { businessInfo } = businessData;
const t = propertiesData.translations;

// Build structured data for the property
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Accommodation",
  "name": property.title,
  "description": property.subtitle,
  "image": property.featuredImage,
  "url": `https://mypattaya.life/properties/${property.slug}`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": property.location.area,
    "addressRegion": "Chonburi",
    "addressCountry": "TH"
  },
  "offers": {
    "@type": "Offer",
    "price": property.price.amount,
    "priceCurrency": property.price.currency,
    "availability": property.status === 'available' ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
  },
  "amenityFeature": property.facilities.map(f => ({
    "@type": "LocationFeatureSpecification",
    "name": f.name
  }))
};

// Facility icons mapping
const facilityIcons: Record<string, string> = {
  pool: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
  fitness: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>`,
  coffee: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>`,
  restaurant: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
  breakfast: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`,
  beach: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12a8 8 0 01-8 8m8-8a8 8 0 00-8-8m8 8h-8m0 8a8 8 0 01-8-8m8 8v-8m-8 8a8 8 0 008-8m-8 8h8"/></svg>`,
  security: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
};
---

<BaseLayout
  title={property.seo.title}
  description={property.seo.description}
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <section class="bg-sand-50 py-4 border-b border-gray-200 relative z-10">
    <div class="container-custom">
      <div class="flex items-center justify-between">
        <nav class="flex items-center gap-2 text-sm">
          <a href="/" class="text-gray-500 hover:text-primary-700 transition-colors">Home</a>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <a href="/properties" class="text-gray-500 hover:text-primary-700 transition-colors">Properties</a>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-gray-900 font-medium" data-en={property.title} data-th={property.titleTh}>{property.title}</span>
        </nav>

        <!-- Language Toggle -->
        <div class="flex items-center gap-2">
          <button
            id="lang-en"
            class="lang-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-primary-700 text-white"
            data-lang="en"
          >
            EN
          </button>
          <button
            id="lang-th"
            class="lang-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-gray-200 text-gray-700 hover:bg-gray-300"
            data-lang="th"
          >
            TH ไทย
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Property Content -->
  <section class="section bg-sand-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Main Content (2 cols) -->
        <div class="lg:col-span-2">
          <!-- Gallery -->
          <PropertyGallery
            featuredImage={property.featuredImage}
            images={property.images}
            title={property.title}
          />

          <!-- Title & Price (Mobile) -->
          <div class="lg:hidden mt-6">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class:list={[
                'px-3 py-1 rounded-full text-xs font-semibold uppercase',
                property.status === 'available' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'
              ]}>
                <span data-en={t.en.available} data-th={t.th.available}>{t.en.available}</span>
              </span>
              {property.rentalTerms?.allInclusive && (
                <span class="bg-secondary-100 text-secondary-700 px-3 py-1 rounded-full text-xs font-semibold">
                  <span data-en={t.en.allInclusive} data-th={t.th.allInclusive}>{t.en.allInclusive}</span>
                </span>
              )}
            </div>
            <h1 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-2" data-en={property.title} data-th={property.titleTh}>
              {property.title}
            </h1>
            <p class="text-lg text-gray-600 mb-4" data-en={property.subtitle} data-th={property.subtitleTh}>{property.subtitle}</p>
            <div class="space-y-2 mb-6">
              {property.salePrice && (
                <div class="flex items-baseline gap-2">
                  <span class="text-2xl font-bold text-secondary-600">{property.salePrice.formatted}</span>
                  <span class="text-gray-600">{property.salePrice.currency} <span data-en="(Sale)" data-th="(ขาย)">(Sale)</span></span>
                </div>
              )}
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-primary-700">{property.price.formatted}</span>
                <span class="text-gray-600">{property.price.currency} / <span data-en="month" data-th="เดือน">month</span></span>
              </div>
            </div>
          </div>

          <!-- Property Details -->
          <div class="bg-white rounded-2xl p-6 shadow-soft mt-6">
            <h2 class="font-display text-xl font-semibold text-gray-900 mb-4" data-en={t.en.propertyDetails} data-th={t.th.propertyDetails}>{t.en.propertyDetails}</h2>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-2xl font-bold text-primary-700">
                  <span data-en={property.details.bedrooms === 0 ? 'Studio' : property.details.bedrooms} data-th={property.details.bedrooms === 0 ? t.th.studio : property.details.bedrooms}>
                    {property.details.bedrooms === 0 ? 'Studio' : property.details.bedrooms}
                  </span>
                </div>
                <div class="text-sm text-gray-600" data-en={property.details.bedrooms === 0 ? 'Type' : 'Bedrooms'} data-th={property.details.bedrooms === 0 ? 'ประเภท' : t.th.bedrooms}>
                  {property.details.bedrooms === 0 ? 'Type' : 'Bedrooms'}
                </div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-2xl font-bold text-primary-700">{property.details.bathrooms}</div>
                <div class="text-sm text-gray-600" data-en={t.en.bathrooms} data-th={t.th.bathrooms}>{t.en.bathrooms}</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-2xl font-bold text-primary-700" data-en={property.details.hasKitchen ? t.en.yes : t.en.no} data-th={property.details.hasKitchen ? t.th.yes : t.th.no}>
                  {property.details.hasKitchen ? 'Yes' : 'No'}
                </div>
                <div class="text-sm text-gray-600" data-en={t.en.kitchen} data-th={t.th.kitchen}>{t.en.kitchen}</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-2xl font-bold text-primary-700 capitalize" data-en={property.details.furnished} data-th={property.details.furnishedTh}>{property.details.furnished}</div>
                <div class="text-sm text-gray-600" data-en={t.en.furnished} data-th={t.th.furnished}>{t.en.furnished}</div>
              </div>
            </div>

            <!-- Rental Terms -->
            {property.rentalTerms && (
              <div class="border-t border-gray-100 pt-6">
                <h3 class="font-semibold text-gray-900 mb-3" data-en={t.en.rentalTerms} data-th={t.th.rentalTerms}>{t.en.rentalTerms}</h3>
                <div class="flex flex-wrap gap-3">
                  {property.rentalTerms.shortTerm && (
                    <span class="flex items-center gap-2 bg-green-50 text-green-700 px-3 py-2 rounded-lg text-sm">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span data-en={t.en.shortTermOK} data-th={t.th.shortTermOK}>{t.en.shortTermOK}</span>
                    </span>
                  )}
                  {property.rentalTerms.longTerm && (
                    <span class="flex items-center gap-2 bg-green-50 text-green-700 px-3 py-2 rounded-lg text-sm">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span data-en={t.en.longTermOK} data-th={t.th.longTermOK}>{t.en.longTermOK}</span>
                    </span>
                  )}
                  {property.rentalTerms.airbnbAllowed && (
                    <span class="flex items-center gap-2 bg-green-50 text-green-700 px-3 py-2 rounded-lg text-sm">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span data-en={t.en.airbnbAllowed} data-th={t.th.airbnbAllowed}>{t.en.airbnbAllowed}</span>
                    </span>
                  )}
                  {property.rentalTerms.allInclusive && (
                    <span class="flex items-center gap-2 bg-secondary-50 text-secondary-700 px-3 py-2 rounded-lg text-sm font-medium">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span data-en={t.en.utilitiesIncluded} data-th={t.th.utilitiesIncluded}>{t.en.utilitiesIncluded}</span>
                    </span>
                  )}
                </div>
              </div>
            )}
          </div>

          <!-- Furniture & Appliances -->
          {property.furniture && property.furniture.length > 0 && (
            <div class="bg-white rounded-2xl p-6 shadow-soft mt-6">
              <h2 class="font-display text-xl font-semibold text-gray-900 mb-4" data-en={t.en.furnitureAppliances} data-th={t.th.furnitureAppliances}>{t.en.furnitureAppliances}</h2>
              <ul class="grid grid-cols-2 gap-3">
                {property.furniture.map((item, index) => (
                  <li class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-gray-700" data-en={item} data-th={property.furnitureTh?.[index] || item}>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Facilities -->
          {property.facilities && property.facilities.length > 0 && (
            <div class="bg-white rounded-2xl p-6 shadow-soft mt-6">
              <h2 class="font-display text-xl font-semibold text-gray-900 mb-4" data-en={t.en.hotelFacilities} data-th={t.th.hotelFacilities}>{t.en.hotelFacilities}</h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                {property.facilities.map((facility) => (
                  <div class="flex items-center gap-3 p-3 bg-primary-50 rounded-xl">
                    <div class="w-10 h-10 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center flex-shrink-0" set:html={facilityIcons[facility.icon] || facilityIcons.security} />
                    <span class="text-gray-700 font-medium text-sm" data-en={facility.name} data-th={facility.nameTh}>{facility.name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Lifestyle Highlight -->
          {property.lifestyleHighlight && (
            <div class="bg-gradient-to-br from-primary-700 to-primary-900 rounded-2xl p-6 md:p-8 shadow-soft mt-6 text-white">
              <h2 class="font-display text-xl font-semibold mb-3" data-en={property.lifestyleHighlight.title} data-th={property.lifestyleHighlight.titleTh}>{property.lifestyleHighlight.title}</h2>
              <p class="text-primary-100 mb-6" data-en={property.lifestyleHighlight.description} data-th={property.lifestyleHighlight.descriptionTh}>{property.lifestyleHighlight.description}</p>

              {property.perfectFor && property.perfectFor.length > 0 && (
                <div>
                  <h3 class="font-semibold mb-3" data-en={t.en.perfectFor + ":"} data-th={t.th.perfectFor + ":"}>Perfect For:</h3>
                  <ul class="grid grid-cols-2 gap-2">
                    {property.perfectFor.map((item, index) => (
                      <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-secondary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-sm" data-en={item} data-th={property.perfectForTh?.[index] || item}>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </div>

        <!-- Sidebar (1 col) -->
        <div class="lg:col-span-1">
          <div class="sticky top-32">
            <!-- Price Card (Desktop) -->
            <div class="hidden lg:block bg-white rounded-2xl p-6 shadow-soft mb-6">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class:list={[
                  'px-3 py-1 rounded-full text-xs font-semibold uppercase',
                  property.status === 'available' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'
                ]}>
                  <span data-en={t.en.available} data-th={t.th.available}>{t.en.available}</span>
                </span>
                {property.rentalTerms?.allInclusive && (
                  <span class="bg-secondary-100 text-secondary-700 px-2 py-1 rounded-full text-xs font-semibold">
                    <span data-en={t.en.allInclusive} data-th={t.th.allInclusive}>{t.en.allInclusive}</span>
                  </span>
                )}
              </div>
              <h1 class="font-display text-2xl font-bold text-gray-900 mb-2" data-en={property.title} data-th={property.titleTh}>{property.title}</h1>
              <p class="text-gray-600 mb-4" data-en={property.subtitle} data-th={property.subtitleTh}>{property.subtitle}</p>
              <div class="space-y-2 pb-4 border-b border-gray-100">
                {property.salePrice && (
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-bold text-secondary-600">{property.salePrice.formatted}</span>
                    <span class="text-gray-600">{property.salePrice.currency} <span data-en="(Sale)" data-th="(ขาย)">(Sale)</span></span>
                  </div>
                )}
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-bold text-primary-700">{property.price.formatted}</span>
                  <span class="text-gray-600">{property.price.currency} / <span data-en="month" data-th="เดือน">month</span></span>
                </div>
              </div>

              <!-- Location -->
              <div class="py-4 border-b border-gray-100">
                <div class="flex items-center gap-2 text-gray-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span data-en={property.location.area} data-th={property.location.areaTh}>{property.location.area}</span>
                  {property.location.walkableToBeach && (
                    <span class="text-blue-600 text-sm">• <span data-en={t.en.walkableToBeach} data-th={t.th.walkableToBeach}>{t.en.walkableToBeach}</span></span>
                  )}
                </div>
              </div>

              <!-- Highlights -->
              <div class="py-4">
                <div class="flex flex-wrap gap-2">
                  {property.highlights.map((highlight, index) => (
                    <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full text-sm font-medium" data-en={highlight} data-th={property.highlightsTh?.[index] || highlight}>
                      {highlight}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Contact Card -->
            <div class="bg-white rounded-2xl p-6 shadow-soft">
              <h3 class="font-display text-lg font-semibold text-gray-900 mb-4" data-en={t.en.interestedInProperty} data-th={t.th.interestedInProperty}>{t.en.interestedInProperty}</h3>
              <p class="text-gray-600 text-sm mb-6" data-en={t.en.contactForAvailability} data-th={t.th.contactForAvailability}>{t.en.contactForAvailability}</p>

              <div class="space-y-3">
                <a
                  href={`https://wa.me/${businessInfo.whatsapp?.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hi! I'm interested in the property: ${property.title} (${property.price.formatted} ${property.price.currency}/${property.price.period}). Is it still available?`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn w-full bg-[#25D366] hover:bg-[#128C7E] text-white flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  <span data-en={t.en.whatsappUs} data-th={t.th.whatsappUs}>{t.en.whatsappUs}</span>
                </a>

                <a
                  href={businessInfo.lineUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn w-full bg-[#00B900] hover:bg-[#00a000] text-white flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
