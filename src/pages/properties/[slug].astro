<script>
  // Language Toggle Script
  let currentLang = 'en';

  function setLanguage(lang: string) {
    currentLang = lang;
    localStorage.setItem('propertyLang', lang);

    // Update all translatable elements
    document.querySelectorAll('[data-en][data-th]').forEach((el) => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) {
        el.textContent = text;
      }
    });

    // Update button styles
    const enBtn = document.getElementById('lang-en');
    const thBtn = document.getElementById('lang-th');

    if (lang === 'en') {
      enBtn?.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
      enBtn?.classList.add('bg-primary-700', 'text-white');
      thBtn?.classList.remove('bg-primary-700', 'text-white');
      thBtn?.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
    } else {
      thBtn?.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
      thBtn?.classList.add('bg-primary-700', 'text-white');
      enBtn?.classList.remove('bg-primary-700', 'text-white');
      enBtn?.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
    }
  }

  // Initialize from localStorage or default to English
  document.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('propertyLang') || 'en';
    setLanguage(savedLang);
  });

  // Add event listeners
  document.getElementById('lang-en')?.addEventListener('click', () => setLanguage('en'));
  document.getElementById('lang-th')?.addEventListener('click', () => setLanguage('th'));
</script>
