---
import BaseLayout from '../layouts/BaseLayout.astro';
import businessData from '../../content/business.json';

const { businessInfo, services } = businessData;
const { houseManagement, premiumAddons, experience, realEstate } = services;

// Service structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Property Management",
  "provider": {
    "@type": "LocalBusiness",
    "name": businessInfo.name,
    "telephone": businessInfo.phone,
    "email": businessInfo.email
  },
  "areaServed": {
    "@type": "City",
    "name": "Pattaya"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Property Management Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Basic Plan",
          "description": "Monthly property inspection, key holding, bill payment coordination"
        },
        "price": "1000",
        "priceCurrency": "THB"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Premium Plan",
          "description": "Weekly property inspection, 24/7 emergency response, full maintenance coordination"
        },
        "price": "2000",
        "priceCurrency": "THB"
      }
    ]
  }
};

const pageTitle = "House Watching Services Pattaya | Property Management Plans from 1,000 THB";
const pageDescription = "Professional house watching and villa management for absentee owners. Key holding, vacant home inspections, bill payment, 24/7 emergency response. English speaking staff.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-20 bg-primary-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/house-managment.webp"
        alt="House watching service Pattaya"
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-primary-900/80"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-3xl">
        <span class="badge bg-secondary-400 text-primary-900 mb-4">House Watching & Villa Care</span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Property Management for Absentee Owners
        </h1>
        <p class="text-xl text-primary-200 mb-6">
          Professional house watching, key holding, and villa management services in Pattaya. English speaking staff, police checked, fully insured.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">English Speaking</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">Police Checked</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">Fully Insured</span>
        </div>
      </div>
    </div>

    <!-- Wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-auto">
        <path d="M0 120L48 110C96 100 192 80 288 70C384 60 480 60 576 65C672 70 768 80 864 85C960 90 1056 90 1152 85C1248 80 1344 70 1392 65L1440 60V120H0Z" fill="#fdfdf9"/>
      </svg>
    </div>
  </section>

  <!-- House Management Section -->
  <section id="house-management" class="py-16 md:py-20 bg-sand-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="badge badge-green mb-4">Property Care</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {houseManagement.title}
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          {houseManagement.description}
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {houseManagement.features.map((feature) => (
          <div class="card card-hover">
            <div class="feature-icon mb-4">
              {feature.icon === 'inspection' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                </svg>
              )}
              {feature.icon === 'key' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                </svg>
              )}
              {feature.icon === 'ac' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {feature.icon === 'mail' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {feature.icon === 'emergency' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              )}
              {feature.icon === 'repair' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">{feature.name}</h3>
            <p class="text-gray-600 text-sm">{feature.description}</p>
          </div>
        ))}
      </div>

      <!-- Pricing Cards -->
      <div class="max-w-4xl mx-auto">
        <!-- Offer Banner -->
        {houseManagement.offer && (
          <div class="bg-secondary-100 border border-secondary-300 rounded-2xl p-6 mb-8 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
            <span class="badge badge-gold text-lg px-4 py-2">{houseManagement.offer.badge}</span>
            <div>
              <p class="font-display text-xl font-semibold text-gray-900">{houseManagement.offer.title}</p>
              <p class="text-gray-600">{houseManagement.offer.description}</p>
            </div>
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-8">
          {houseManagement.plans.map((plan) => (
            <div class:list={['card', { 'card-featured': plan.isFeatured }]}>
              {plan.isFeatured && (
                <div class="flex justify-end -mt-2 -mr-2 mb-4">
                  <span class="badge badge-gold">Recommended</span>
                </div>
              )}
              <h3 class="font-display text-2xl font-semibold text-gray-900 mb-2">{plan.name}</h3>
              <div class="flex items-baseline gap-1 mb-6">
                <span class="price text-primary-700">{plan.price}</span>
                <span class="price-currency">{plan.currency} / {plan.period}</span>
              </div>
              <ul class="space-y-3 mb-8">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-gray-600">{feature}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/contact"
                class:list={['btn w-full', plan.isFeatured ? 'btn-primary' : 'btn-outline']}
              >
                Choose {plan.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Premium Add-ons Section -->
  <section id="addons" class="py-16 md:py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="badge badge-gold mb-4">Add-ons</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Premium Home Services
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Enhance your property management with our premium add-on services
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {premiumAddons.map((addon) => (
          <div class="card card-hover overflow-hidden p-0">
            <!-- Image -->
            <div class="relative h-40 overflow-hidden">
              {addon.icon === 'cleaning' && (
                <img
                  src="/images/cleaning-service.webp"
                  alt="Professional cleaning service"
                  class="w-full h-full object-cover"
                />
              )}
              {addon.icon === 'linen' && (
                <img
                  src="/images/linen-laundry-card.webp"
                  alt="Fresh linen and laundry service"
                  class="w-full h-full object-cover"
                />
              )}
              {addon.icon === 'pool' && (
                <img
                  src="/images/pool-garden-card.webp"
                  alt="Pool and garden maintenance"
                  class="w-full h-full object-cover"
                />
              )}
            </div>

            <div class="p-6">
              <h3 class="font-display text-xl font-semibold text-gray-900 mb-2">{addon.title}</h3>
              <p class="text-gray-600 mb-6">{addon.description}</p>

              <div class="space-y-4 pt-4 border-t border-gray-100">
                {addon.options.map((option) => (
                  <div class="flex justify-between items-center">
                    <div>
                      <p class="font-medium text-gray-900">{option.name}</p>
                      <p class="text-sm text-gray-500">{option.note}</p>
                    </div>
                    <p class="font-semibold text-primary-700 whitespace-nowrap">
                      {option.priceRange} <span class="text-sm font-normal text-gray-500">{option.currency}</span>
                    </p>
                  </div>
                ))}
              </div>
              <a href="/contact" class="btn btn-outline btn-sm w-full mt-4">Get Quote</a>
            </div>
          </div>
        ))}
      </div>

      <!-- Section CTA -->
      <div class="text-center mt-12">
        <a href="/contact" class="btn btn-primary">
          Request All Add-on Services
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Culinary Experiences Section -->
  <section id="experience" class="bg-primary-900 py-16 md:py-20 relative overflow-hidden">
    <div class="container-custom">
      <div class="text-center mb-16">
        <span class="badge bg-secondary-400 text-primary-900 mb-4">Culinary</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
          {experience.title}
        </h2>
        <p class="text-lg text-primary-200 max-w-2xl mx-auto">
          {experience.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {experience.items.map((item) => (
          <div class="bg-primary-800/50 rounded-2xl overflow-hidden border border-primary-700/50">
            <!-- Image -->
            <div class="relative h-48 overflow-hidden">
              {item.id === 'personal-chef' && (
                <img
                  src="/images/catering-with-chef.webp"
                  alt="Private Thai chef preparing authentic cuisine"
                  class="w-full h-full object-cover"
                />
              )}
              {item.id === 'bbq-seafood' && (
                <img
                  src="/images/chef-seafood.webp"
                  alt="Fresh BBQ seafood dinner setup"
                  class="w-full h-full object-cover"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 to-transparent"></div>
              <span class="absolute bottom-4 right-4 badge bg-secondary-400 text-primary-900">
                {item.price} {item.currency}
              </span>
            </div>

            <div class="p-8">
              <h3 class="font-display text-2xl font-semibold text-white mb-3">{item.title}</h3>
              <p class="text-primary-200 mb-4">{item.description}</p>
              <p class="text-secondary-400 text-sm font-medium mb-6">{item.minOrder}</p>

              <div class="grid grid-cols-2 gap-3 mb-6">
                {item.highlights.map((highlight) => (
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-secondary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-sm text-primary-100">{highlight}</span>
                  </div>
                ))}
              </div>

              <a href="/contact" class="btn btn-secondary w-full">
                Book Experience
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real Estate Section -->
  <section id="real-estate" class="py-16 md:py-20 bg-sand-100">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="badge badge-green mb-4">Real Estate</span>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            {realEstate.title}
          </h2>
          <p class="text-lg text-gray-600">
            {realEstate.description}
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Image -->
          <div class="rounded-2xl overflow-hidden shadow-soft-lg">
            <img
              src="/images/house-promo-selling.webp"
              alt="Property promotion and real estate marketing"
              class="w-full h-64 lg:h-80 object-cover"
            />
          </div>

          <!-- Content Card -->
          <div class="card bg-white">
          <div class="flex flex-col md:flex-row items-start justify-between gap-4 mb-8">
            <div>
              <h3 class="font-display text-2xl font-semibold text-gray-900">{realEstate.package.name}</h3>
              <p class="text-gray-500">{realEstate.package.priceNote}</p>
            </div>
            <div class="text-left md:text-right">
              <p class="text-sm text-gray-500">Starting from</p>
              <p class="price text-2xl text-primary-700">{realEstate.package.priceRange} <span class="price-currency">{realEstate.package.currency}</span></p>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            {realEstate.package.features.map((feature) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center flex-shrink-0">
                  {feature.icon === 'camera' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  )}
                  {feature.icon === 'video' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  )}
                  {feature.icon === 'drone' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  )}
                  {feature.icon === 'social' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                    </svg>
                  )}
                  {feature.icon === 'listing' && (
                    <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  )}
                </div>
                <div>
                  <h4 class="font-medium text-gray-900">{feature.name}</h4>
                  <p class="text-sm text-gray-600">{feature.description}</p>
                </div>
              </div>
            ))}
          </div>

          <a href="/contact" class="btn btn-primary w-full md:w-auto">
            Get a Quote
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container-custom">
      <div class="bg-tropical-gradient rounded-3xl p-8 md:p-12 lg:p-16 text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-secondary-400/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>

        <div class="relative z-10">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
            Get Your Free Property Assessment
          </h2>
          <p class="text-lg text-primary-100 mb-8 max-w-2xl mx-auto">
            Let us evaluate your property's needs and create a customized management plan. House watching services start from just 1,000 THB/month.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact" class="btn btn-secondary text-lg px-8 py-4 min-h-[48px]">
              Request Free Quote
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href={businessInfo.lineUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost text-lg px-8 py-4 min-h-[48px]">
              <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
