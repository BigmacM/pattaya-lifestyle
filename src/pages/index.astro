---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AddonsSection from '../components/AddonsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import RealEstateSection from '../components/RealEstateSection.astro';
import businessData from '../../content/business.json';

const { businessInfo, services } = businessData;

// LocalBusiness structured data for homepage
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": businessInfo.name,
  "description": businessInfo.description,
  "url": businessInfo.siteUrl,
  "telephone": businessInfo.phone,
  "email": businessInfo.email,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Pattaya",
    "addressRegion": "Chonburi",
    "addressCountry": "TH"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": businessInfo.geo.latitude,
    "longitude": businessInfo.geo.longitude
  },
  "priceRange": businessInfo.priceRange,
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "09:00",
      "closes": "16:00"
    }
  ],
  "sameAs": [
    businessData.socials?.facebook,
    businessData.socials?.instagram
  ].filter(Boolean)
};

const pageTitle = "Premium Property Management & Concierge Services";
const pageDescription = businessInfo.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Services Section -->
  <ServicesSection />

  <!-- Add-ons Section -->
  <AddonsSection />

  <!-- Experience Section -->
  <ExperienceSection />

  <!-- Real Estate Section -->
  <RealEstateSection />

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-sand-100">
    <div class="container-custom">
      <div class="bg-tropical-gradient rounded-3xl p-8 md:p-12 lg:p-16 text-center relative overflow-hidden">
        <!-- Decorative Elements -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-secondary-400/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>

        <div class="relative z-10">
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
            Ready to Simplify Your Property Management?
          </h2>
          <p class="text-lg md:text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
            Let us take care of your villa while you enjoy the best of Pattaya. Contact us today for a personalized consultation.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact" class="btn btn-secondary text-lg px-8 py-4">
              Get Started Today
            </a>
            <a href={`tel:${businessInfo.phone.replace(/\s/g, '')}`} class="btn btn-ghost text-lg px-8 py-4">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {businessInfo.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
