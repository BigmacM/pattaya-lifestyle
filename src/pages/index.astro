---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import FearsSection from '../components/FearsSection.astro';
import AddonsSection from '../components/AddonsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import RealEstateSection from '../components/RealEstateSection.astro';
import businessData from '../../content/business.json';

const { businessInfo, managedAreas } = businessData;
---

<BaseLayout isHomepage={true}>
  <!-- Hero Section -->
  <Hero />

  <!-- Services Section (Management Silo) -->
  <ServicesSection />

  <!-- Fears Section (Asset Protection) -->
  <FearsSection />

  <!-- Add-ons Section (Maintenance Silo) -->
  <AddonsSection />

  <!-- Experience Section (Lifestyle Silo) -->
  <ExperienceSection />

  <!-- Real Estate Section -->
  <RealEstateSection />

  <!-- Areas Served Section -->
  <section class="py-12 bg-white">
    <div class="container-custom">
      <div class="text-center mb-8">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-2">
          Areas We Serve in Pattaya
        </h2>
        <p class="text-gray-600">Professional house watching and villa management across all major Pattaya neighborhoods</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {managedAreas.map((area) => (
          <span class="bg-primary-50 text-primary-700 px-4 py-2 rounded-full text-sm font-medium">
            {area}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20 bg-sand-100">
    <div class="container-custom">
      <div class="bg-tropical-gradient rounded-3xl p-8 md:p-12 lg:p-16 text-center relative overflow-hidden">
        <!-- Decorative Elements -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-secondary-400/10 rounded-full blur-3xl parallax-slow"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-white/5 rounded-full blur-3xl parallax-slow" style="animation-delay: -4s;"></div>

        <div class="relative z-10">
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
            Get Your Free Property Assessment
          </h2>
          <p class="text-lg md:text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
            Let us evaluate your property's needs and create a customized management plan. House watching services start from just 1,000 THB/month.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact" class="btn btn-secondary text-lg px-8 py-4 min-h-[48px] hover-glow">
              Request Free Quote
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href={businessInfo.lineUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost text-lg px-8 py-4 min-h-[48px]">
              <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.105.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
              Chat on LINE
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
