---
import BaseLayout from '../layouts/BaseLayout.astro';
import businessData from '../../content/business.json';

const { businessInfo, contactPage } = businessData;

// ContactPage structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact ${businessInfo.name}`,
  "description": "Get in touch with Pattaya Lifestyle for property management and concierge services in Pattaya, Thailand.",
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessInfo.name,
    "telephone": businessInfo.phone,
    "email": businessInfo.email,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Pattaya",
      "addressRegion": "Chonburi",
      "addressCountry": "TH"
    }
  }
};

const pageTitle = "Contact Us | Free Property Assessment | Pattaya Property Management";
const pageDescription = "Get a free property assessment and customized management quote. English speaking staff available via phone, email, or LINE. 24/7 emergency hotline.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-20 bg-primary-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/Hero-villa-lifestyle.webp"
        alt="Contact Pattaya property management"
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-primary-900/80"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-3xl">
        <span class="badge bg-secondary-400 text-primary-900 mb-4">Free Property Assessment</span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Get Your Free Quote
        </h1>
        <p class="text-xl text-primary-200 mb-6">
          {contactPage.contactMessage}
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">English Speaking</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">24/7 Emergency</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">Free Consultation</span>
        </div>
      </div>
    </div>

    <!-- Wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-auto">
        <path d="M0 120L48 110C96 100 192 80 288 70C384 60 480 60 576 65C672 70 768 80 864 85C960 90 1056 90 1152 85C1248 80 1344 70 1392 65L1440 60V120H0Z" fill="#fdfdf9"/>
      </svg>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section bg-sand-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Information -->
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-8">
            Contact Information
          </h2>

          <div class="space-y-6 mb-10">
            <!-- Phone -->
            <a
              href={`tel:${businessInfo.phone.replace(/[-\s]/g, '')}`}
              class="card card-hover block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Phone</h3>
                  <span class="text-lg text-primary-700">
                    {businessInfo.phone}
                  </span>
                  <p class="text-sm text-gray-500 mt-1">Tap to call</p>
                </div>
              </div>
            </a>

            <!-- WhatsApp -->
            <a
              href={`https://wa.me/${businessInfo.whatsapp?.replace(/[^0-9]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="card card-hover bg-[#25D366]/5 border-[#25D366]/20 block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#25D366] flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">WhatsApp</h3>
                  <span class="text-lg text-[#25D366]">
                    {businessInfo.whatsapp}
                  </span>
                  <p class="text-sm text-gray-500 mt-1">Tap to chat instantly</p>
                </div>
              </div>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${businessInfo.email}`}
              class="card card-hover block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Email</h3>
                  <span class="text-lg text-primary-700 break-all">
                    {businessInfo.email}
                  </span>
                  <p class="text-sm text-gray-500 mt-1">Tap to send email</p>
                </div>
              </div>
            </a>

            <!-- LINE -->
            <a
              href={businessInfo.lineUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="card card-hover bg-[#00B900]/5 border-[#00B900]/20 block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#00B900] flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.105.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">LINE Chat</h3>
                  <span class="text-lg text-[#00B900]">
                    {businessInfo.lineId}
                  </span>
                  <p class="text-sm text-gray-500 mt-1">Tap to open LINE</p>
                </div>
              </div>
            </a>

            <!-- Emergency Hotline -->
            <a
              href={`tel:${businessInfo.emergencyHotline?.replace(/[-\s]/g, '')}`}
              class="card card-hover bg-red-50 border-red-100 block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">24/7 Emergency Hotline</h3>
                  <span class="text-lg text-red-600">
                    {businessInfo.emergencyHotline}
                  </span>
                  <p class="text-sm text-gray-500 mt-1">Tap to call for urgent issues</p>
                </div>
              </div>
            </a>

            <!-- Address -->
            <a
              href={businessInfo.googleMapsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="card card-hover block cursor-pointer"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Location</h3>
                  <p class="text-lg text-gray-700">{businessInfo.address.street}, {businessInfo.address.locality}</p>
                  <p class="text-gray-600">{businessInfo.address.region} {businessInfo.address.postalCode}</p>
                  <span class="inline-flex items-center gap-1 text-sm text-primary-700 mt-2">
                    Tap for directions
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </div>

          <!-- Office Hours -->
          <div class="card bg-primary-50 border border-primary-100">
            <h3 class="font-display text-xl font-semibold text-gray-900 mb-4">Office Hours</h3>
            <ul class="space-y-3">
              {businessInfo.hours.map((schedule) => (
                <li class="flex justify-between items-center">
                  <span class="text-gray-600">{schedule.days}</span>
                  <span class="font-medium text-gray-900">{schedule.time}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Map & Form -->
        <div>
          <!-- Map -->
          <div class="rounded-2xl overflow-hidden shadow-soft mb-8 h-80">
            <iframe
              src={contactPage.mapEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Pattaya Lifestyle Location"
            ></iframe>
          </div>

          <!-- Contact Form -->
          <div class="card">
            <h3 class="font-display text-xl font-semibold text-gray-900 mb-6">Send us a Message</h3>
            <form id="contact-form" class="space-y-4">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="label">Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    class="input"
                    placeholder="Your name"
                    required
                  />
                </div>
                <div>
                  <label for="email" class="label">Email *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="input"
                    placeholder="your@email.com"
                    required
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="label">Phone (Optional)</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="input"
                    placeholder="+66 XX XXX XXXX"
                  />
                </div>
                <div>
                  <label for="line-id" class="label">LINE ID (Optional)</label>
                  <input
                    type="text"
                    id="line-id"
                    name="line-id"
                    class="input"
                    placeholder="@yourlineid"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="label">Service Interest *</label>
                <select id="service" name="service" class="input" required>
                  <option value="">Select a service...</option>
                  <optgroup label="Property Management">
                    <option value="House Management - Basic Plan">House Management - Basic Plan (1,000 THB/mo)</option>
                    <option value="House Management - Premium Plan">House Management - Premium Plan (2,000 THB/mo)</option>
                  </optgroup>
                  <optgroup label="Property Maintenance">
                    <option value="Deep Cleaning Service">Deep Cleaning Service</option>
                    <option value="Move Out Cleaning">Move Out Cleaning</option>
                    <option value="Pool Cleaning">Pool Cleaning (Monthly)</option>
                    <option value="Garden Care">Garden Care (Monthly)</option>
                  </optgroup>
                  <optgroup label="Lifestyle Services">
                    <option value="Private Thai Chef">Private Thai Chef (1,500 THB/person)</option>
                    <option value="BBQ Seafood Catering">BBQ Seafood Catering (2,500 THB/set)</option>
                    <option value="Linen Rental">Linen Rental Service</option>
                  </optgroup>
                  <optgroup label="Real Estate">
                    <option value="Property Marketing Package">Property Marketing & Sales Package</option>
                  </optgroup>
                  <option value="Multiple Services">Multiple Services (specify below)</option>
                  <option value="Other">Other (specify below)</option>
                </select>
              </div>

              <div>
                <label for="property-location" class="label">Property Location (Optional)</label>
                <select id="property-location" name="property-location" class="input">
                  <option value="">Select area...</option>
                  <option value="Pratamnak Hill">Pratamnak Hill</option>
                  <option value="Jomtien">Jomtien</option>
                  <option value="Na Jomtien">Na Jomtien</option>
                  <option value="Wongamat">Wongamat</option>
                  <option value="Central Pattaya">Central Pattaya</option>
                  <option value="East Pattaya">East Pattaya</option>
                  <option value="Huay Yai">Huay Yai</option>
                  <option value="Bang Saray">Bang Saray</option>
                  <option value="Other">Other Area</option>
                </select>
              </div>

              <div>
                <label for="message" class="label">Message *</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="input resize-none"
                  placeholder="Tell us about your property and needs..."
                  required
                ></textarea>
              </div>

              <button type="submit" class="btn btn-primary w-full flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Send via WhatsApp
              </button>

              <p class="text-xs text-gray-500 text-center mt-2">
                Your message will open in WhatsApp for quick response
              </p>
            </form>
          </div>

          <script>
            // TEST NUMBER - Change to client number for production: +66660418885
            const WHATSAPP_NUMBER = '16479094565';

            document.getElementById('contact-form')?.addEventListener('submit', function(e) {
              e.preventDefault();

              const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
              const email = (document.getElementById('email') as HTMLInputElement)?.value || '';
              const phone = (document.getElementById('phone') as HTMLInputElement)?.value || '';
              const lineId = (document.getElementById('line-id') as HTMLInputElement)?.value || '';
              const service = (document.getElementById('service') as HTMLSelectElement)?.value || '';
              const location = (document.getElementById('property-location') as HTMLSelectElement)?.value || '';
              const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

              // Build WhatsApp message
              let whatsappMessage = `*New Inquiry from Pattaya Lifestyle Website*\n\n`;
              whatsappMessage += `*Name:* ${name}\n`;
              whatsappMessage += `*Email:* ${email}\n`;
              if (phone) whatsappMessage += `*Phone:* ${phone}\n`;
              if (lineId) whatsappMessage += `*LINE ID:* ${lineId}\n`;
              whatsappMessage += `*Service:* ${service}\n`;
              if (location) whatsappMessage += `*Property Location:* ${location}\n`;
              whatsappMessage += `\n*Message:*\n${message}`;

              // Encode and open WhatsApp
              const encodedMessage = encodeURIComponent(whatsappMessage);
              const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`;

              window.open(whatsappUrl, '_blank');
            });
          </script>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Links Section -->
  <section class="py-12 bg-white">
    <div class="container-custom">
      <div class="text-center">
        <h2 class="font-display text-2xl font-semibold text-gray-900 mb-6">Follow Us</h2>
        <div class="flex justify-center gap-4">
          {businessData.socials?.facebook && (
            <a
              href={businessData.socials.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-primary-100 hover:bg-primary-200 flex items-center justify-center transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-6 h-6 text-primary-700" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {businessData.socials?.instagram && (
            <a
              href={businessData.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-primary-100 hover:bg-primary-200 flex items-center justify-center transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-6 h-6 text-primary-700" fill="currentColor" viewBox="0 0 24 24">
