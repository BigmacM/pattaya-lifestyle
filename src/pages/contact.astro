---
import BaseLayout from '../layouts/BaseLayout.astro';
import businessData from '../../content/business.json';

const { businessInfo, contactPage } = businessData;

// ContactPage structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact ${businessInfo.name}`,
  "description": "Get in touch with Pattaya Lifestyle for property management and concierge services in Pattaya, Thailand.",
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessInfo.name,
    "telephone": businessInfo.phone,
    "email": businessInfo.email,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Pattaya",
      "addressRegion": "Chonburi",
      "addressCountry": "TH"
    }
  }
};

const pageTitle = "Contact Us | Free Property Assessment | Pattaya Property Management";
const pageDescription = "Get a free property assessment and customized management quote. English speaking staff available via phone, email, or LINE. 24/7 emergency hotline.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-20 bg-primary-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img
        src="/images/Hero-villa-lifestyle.webp"
        alt="Contact Pattaya property management"
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-primary-900/80"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-3xl">
        <span class="badge bg-secondary-400 text-primary-900 mb-4">Free Property Assessment</span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Get Your Free Quote
        </h1>
        <p class="text-xl text-primary-200 mb-6">
          {contactPage.contactMessage}
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">English Speaking</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">24/7 Emergency</span>
          <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1 text-sm text-white">Free Consultation</span>
        </div>
      </div>
    </div>

    <!-- Wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-auto">
        <path d="M0 120L48 110C96 100 192 80 288 70C384 60 480 60 576 65C672 70 768 80 864 85C960 90 1056 90 1152 85C1248 80 1344 70 1392 65L1440 60V120H0Z" fill="#fdfdf9"/>
      </svg>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section bg-sand-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Information -->
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-8">
            Contact Information
          </h2>

          <div class="space-y-6 mb-10">
            <!-- Phone -->
            <div class="card card-hover">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Phone</h3>
                  <a
                    href={`tel:${businessInfo.phone.replace(/\s/g, '')}`}
                    class="text-lg text-primary-700 hover:text-primary-800 transition-colors"
                  >
                    {businessInfo.phone}
                  </a>
                  <p class="text-sm text-gray-500 mt-1">Click to call</p>
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="card card-hover">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Email</h3>
                  <a
                    href={`mailto:${businessInfo.email}`}
                    class="text-lg text-primary-700 hover:text-primary-800 transition-colors break-all"
                  >
                    {businessInfo.email}
                  </a>
                  <p class="text-sm text-gray-500 mt-1">We'll respond within 24 hours</p>
                </div>
              </div>
            </div>

            <!-- LINE -->
            <div class="card card-hover bg-[#00B900]/5 border-[#00B900]/20">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#00B900] flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.105.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">LINE Chat</h3>
                  <a
                    href={businessInfo.lineUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lg text-[#00B900] hover:text-[#00a000] transition-colors"
                  >
                    {businessInfo.lineId}
                  </a>
                  <p class="text-sm text-gray-500 mt-1">Fastest response time</p>
                </div>
              </div>
            </div>

            <!-- Emergency Hotline -->
            <div class="card card-hover bg-red-50 border-red-100">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">24/7 Emergency Hotline</h3>
                  <a
                    href={`tel:${businessInfo.emergencyHotline?.replace(/\s/g, '')}`}
                    class="text-lg text-red-600 hover:text-red-700 transition-colors"
                  >
                    {businessInfo.emergencyHotline}
                  </a>
                  <p class="text-sm text-gray-500 mt-1">For urgent property issues</p>
                </div>
              </div>
            </div>

            <!-- Address -->
            <div class="card card-hover">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Location</h3>
                  <p class="text-lg text-gray-700">{businessInfo.address.street}, {businessInfo.address.locality}</p>
                  <p class="text-gray-600">{businessInfo.address.region} {businessInfo.address.postalCode}</p>
                  <a
                    href={businessInfo.googleMapsLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-sm text-primary-700 hover:text-primary-800 mt-2 transition-colors"
                  >
                    Get Directions
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Office Hours -->
          <div class="card bg-primary-50 border border-primary-100">
            <h3 class="font-display text-xl font-semibold text-gray-900 mb-4">Office Hours</h3>
            <ul class="space-y-3">
              {businessInfo.hours.map((schedule) => (
                <li class="flex justify-between items-center">
                  <span class="text-gray-600">{schedule.days}</span>
                  <span class="font-medium text-gray-900">{schedule.time}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Map & Form -->
        <div>
          <!-- Map -->
          <div class="rounded-2xl overflow-hidden shadow-soft mb-8 h-80">
            <iframe
              src={contactPage.mapEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Pattaya Lifestyle Location"
            ></iframe>
          </div>

          <!-- Contact Form -->
          <div class="card">
            <h3 class="font-display text-xl font-semibold text-gray-900 mb-6">Send us a Message</h3>
            <form class="space-y-4">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="label">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    class="input"
                    placeholder="Your name"
                    required
                  />
                </div>
                <div>
                  <label for="email" class="label">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="input"
                    placeholder="your@email.com"
                    required
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="label">Phone (Optional)</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="input"
                    placeholder="+66 XX XXX XXXX"
                  />
                </div>
                <div>
                  <label for="line-id" class="label">LINE ID (Optional)</label>
                  <input
                    type="text"
                    id="line-id"
                    name="line-id"
                    class="input"
                    placeholder="@yourlineid"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="label">Service Interest</label>
                <select id="service" name="service" class="input">
                  <option value="">Select a service...</option>
                  <option value="house-management">House Management</option>
                  <option value="cleaning">Cleaning Service</option>
                  <option value="pool-garden">Pool & Garden</option>
                  <option value="chef">Personal Chef</option>
                  <option value="real-estate">Real Estate Marketing</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="label">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="input resize-none"
                  placeholder="Tell us about your needs..."
                  required
                ></textarea>
              </div>

              <button type="submit" class="btn btn-primary w-full">
                Send Message
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Links Section -->
  <section class="py-12 bg-white">
    <div class="container-custom">
      <div class="text-center">
        <h2 class="font-display text-2xl font-semibold text-gray-900 mb-6">Follow Us</h2>
        <div class="flex justify-center gap-4">
          {businessData.socials?.facebook && (
            <a
              href={businessData.socials.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-primary-100 hover:bg-primary-200 flex items-center justify-center transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-6 h-6 text-primary-700" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {businessData.socials?.instagram && (
            <a
              href={businessData.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-primary-100 hover:bg-primary-200 flex items-center justify-center transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-6 h-6 text-primary-700" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {businessData.socials?.line && (
            <a
              href={businessData.socials.line}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-primary-100 hover:bg-primary-200 flex items-center justify-center transition-colors"
              aria-label="LINE"
            >
              <svg class="w-6 h-6 text-primary-700" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.349 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
